rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: each user can only read and write their own document
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Chat history per user: owner-only client read/write
    match /chat_history/{chatId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Learning plans per user: owner-only client read/write
    match /plans/{planId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Daily tasks per user: owner-only client read/write
    match /tasks/{taskId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Learning paths: authenticated read, server-only write (Firebase Admin SDK)
    match /learning_paths/{pathId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Learning modules: authenticated read, server-only write (Firebase Admin SDK)
    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // User progress per path and module: strictly scoped to the authenticated user
    match /user_progress/{progressId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Projects: owner-only client read/write
    match /projects/{projectId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Interviews: owner-only client read/write
    match /interviews/{interviewId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Jobs: owner-only client read/write
    match /jobs/{jobId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Radar feedback (likes, saves, seen) per user
    match /radar_feedback/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Public job posts: readable by all authenticated users
    match /job_posts/{jobId} {
      allow read: if isAuthenticated();
      allow write: if false; // server-only writes
    }

    // Job matches: user-specific matches (owner-only client read)
    match /job_matches/{matchId} {
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // Job alerts run log
    match /job_alerts_log/{logId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // In-app notifications: owner-only client read
    match /notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // Observability telemetry: owner-only client read, server-only write
    match /agent_runs/{runId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false; // written exclusively via Firebase Admin SDK
    }
  }
}
